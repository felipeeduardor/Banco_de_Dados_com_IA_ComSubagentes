# ============================================
# AI Data Assistant - Environment Variables
# ============================================
#
# Copie este arquivo para .env e configure as variaveis
# cp .env.example .env
#
# IMPORTANTE: O sistema opera em dois modos:
# - MODO DEMO: Quando SUPABASE_URL nao esta configurado (usa dados mock)
# - MODO PRODUCAO: Quando SUPABASE_URL esta configurado (usa Supabase)

# ============================================
# Supabase Configuration (Database)
# ============================================
# Para usar o modo DEMO (dados mock), deixe estas variaveis comentadas ou vazias
# Para usar banco de dados real, configure com suas credenciais do Supabase
#
# SUPABASE_URL deve ser no formato: https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY eh o token JWT publico do seu projeto Supabase
#
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (opcional - apenas para operacoes administrativas)
# NUNCA exponha esta chave no frontend!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# AI/NLP Configuration
# ============================================
# Configure pelo menos uma das opcoes abaixo para processamento de linguagem natural
# Se nenhuma estiver configurada, o sistema usara regras basicas de NLP

# OpenAI API Key (GPT-3.5/GPT-4)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Claude API Key (alternativa ao OpenAI)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ============================================
# Server Configuration
# ============================================
# Porta do servidor backend (padrao: 4000)
PORT=4000

# Ambiente de execucao (development | production | test)
NODE_ENV=development

# ============================================
# CORS Configuration
# ============================================
# URL do frontend para configuracao de CORS
FRONTEND_URL=http://localhost:3000

# Origens permitidas (separadas por virgula) - usado em producao
# ALLOWED_ORIGINS=https://seu-dominio.com,https://app.seu-dominio.com

# ============================================
# Logging Configuration (opcional)
# ============================================
# Nivel de log (debug | info | warn | error)
# LOG_LEVEL=info

# ============================================
# Rate Limiting (opcional)
# ============================================
# Limite de requisicoes por minuto por IP
# RATE_LIMIT_PER_MINUTE=100

# ============================================
# MODO DEMO - Informacoes
# ============================================
# Quando em modo demo, o sistema usa os seguintes dados mock:
# - transactions: 20 registros de transacoes
# - products: 10 produtos de cursos
# - customers: 15 clientes
# - orders: 25 pedidos
#
# Perguntas de exemplo que funcionam no modo demo:
# - "Quantas transacoes temos?"
# - "Qual o valor total de vendas?"
# - "Quais produtos temos na categoria Frontend?"
# - "Liste os clientes de Sao Paulo"
# - "Mostre os pedidos pendentes"
